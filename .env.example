# ─────────────────────────────────────────────────────────────
# Contact form email (SMTP)  —  copy this file to .env.local and
# fill in the values. NEVER commit .env.local (it is gitignored).
# ─────────────────────────────────────────────────────────────

# Gmail / Google Workspace SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# The mailbox that authenticates AND sends the message.
SMTP_USER=andrey@lumintik.com

# Google "App Password" (16 chars, no spaces) for the account above.
# Generate at: Google Account → Security → 2-Step Verification → App passwords.
# Paste it here WITHOUT spaces, e.g. SMTP_PASSWORD=abcdabcdabcdabcd
SMTP_PASSWORD=

# Where contact submissions are delivered (defaults to SMTP_USER if unset).
CONTACT_TO=andrey@lumintik.com,david@lumintik.com
